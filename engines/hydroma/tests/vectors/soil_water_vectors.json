      "expected": { "ok": true, "root_zone_depth_mm": 300, "taw_mm": 60, "storage_mm": 85, "depletion_mm": 30, "raw_mm": 36, "remaining_mm": 30, "depletion_fraction": 0.5, "status": "readily_available", "warnings": [], "errors": [] }
    },
