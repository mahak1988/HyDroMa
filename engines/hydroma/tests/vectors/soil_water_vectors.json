      "expected": { "ok": true, "root_zone_depth_mm": 300, "taw_mm": 60, "storage_mm": 45, "depletion_mm": 45, "raw_mm": 18, "remaining_mm": 15, "depletion_fraction": 0.75, "status": "stressed", "warnings": ["RAW_DEPLETION_REACHED"], "errors": [] }
