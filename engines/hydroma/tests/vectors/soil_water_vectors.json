    },
    {
      "id": "theta-unit-mismatch",
      "input": { "layers": [{ "thickness_mm": 300, "theta_fc": { "value": 0.30, "unit": "mm" }, "theta_wp": 0.10, "theta_actual": 0.20 }] },
