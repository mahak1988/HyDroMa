{
  "contract": "eco-nojin.hydroma.soil-water-storage@1.0.0",
  "note": "Independent reference values derived by hand from TAW=(theta_fc-theta_wp)*Z, storage=theta_actual*Z, available=(theta_actual-theta_wp)*Z, depletion=(theta_fc-theta_actual)*Z, RAW=p*TAW, depletion_fraction=depletion/TAW. Z is the effective thickness within the root zone. NOT generated by the implementation. Numeric tolerance 1e-3. Status semantics: stressed when depletion >= RAW (stress threshold reached).",
  "tolerance": 0.001,
