    },
    {
      "id": "theta-fc-le-wp",
      "input": { "layers": [{ "thickness_mm": 300, "theta_fc": 0.10, "theta_wp": 0.10 }] },
      "expected": { "ok": false, "root_zone_depth_mm": null, "taw_mm": null, "storage_mm": null, "depletion_mm": null, "raw_mm": null, "remaining_mm": null, "depletion_fraction": null, "status": null, "warnings": [], "errors": ["THETA_FC_MUST_EXCEED_WP"] }
