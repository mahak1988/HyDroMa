      "expected": { "ok": true, "root_zone_depth_mm": 300, "taw_mm": 60, "storage_mm": 90, "depletion_mm": 0, "raw_mm": 30, "remaining_mm": 60, "depletion_fraction": 0.0, "status": "at_field_capacity", "warnings": [], "errors": [] }
    },
    {
