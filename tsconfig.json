{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/console/src/*"],
      "@eco-nojin/design-system/*": ["packages/design-system/*"],
      "@eco-nojin/ui": ["packages/ui/src/index.ts"],
      "@eco-nojin/i18n": ["packages/i18n/src/index.ts"],
      "@eco-nojin/frontend-core": ["packages/frontend-core/src/index.ts"]
    }
  },
  "include": ["apps/console/src", "apps/console/tests", "apps/portal/src", "apps/portal/tests", "apps/scientific-workspace/src", "apps/scientific-workspace/tests", "apps/marketplace/src", "apps/marketplace/tests", "packages/ui/src", "packages/i18n/src", "packages/frontend-core/src", "packages/domain-types/src", "packages/validation/src", "packages/api-client/src", "packages/ui/tests", "packages/i18n/tests", "packages/domain-types/tests", "packages/validation/tests", "packages/api-client/tests", "vitest.setup.ts"]
}