{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/console/src/*"],
      "@eco-nojin/design-system/*": ["packages/design-system/*"],
      "@eco-nojin/ui": ["packages/ui/src/index.ts"],
      "@eco-nojin/icons": ["packages/icons/src/index.ts"],
      "@eco-nojin/i18n": ["packages/i18n/src/index.ts"],
      "@eco-nojin/frontend-core": ["packages/frontend-core/src/index.ts"],
      "@eco-nojin/configuration": ["packages/configuration/src/index.ts"],
      "@eco-nojin/auth-client": ["packages/auth-client/src/index.ts"],
      "@eco-nojin/utilities": ["packages/utilities/src/index.ts"],
      "@eco-nojin/scientific": ["packages/scientific/src/index.ts"],
      "@eco-nojin/spatial": ["packages/spatial/src/index.ts"]
    }
  },
  "include": [
    "apps/home/src",
    "apps/brand/src",
    "apps/platform/src",
    "apps/console/src",
    "apps/console/tests",
    "apps/portal/src",
    "apps/portal/tests",
    "apps/scientific-workspace/src",
    "apps/scientific-workspace/tests",
    "apps/marketplace/src",
    "apps/marketplace/tests",
    "apps/tourism/src",
    "apps/tourism/tests",
    "packages/*/src",
    "packages/*/tests",
    "vitest.setup.ts"
  ]
}