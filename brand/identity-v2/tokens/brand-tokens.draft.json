  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px",
      "9": "96px"
    }
  },

  "layout": {
    "container": {
      "wide": "1440px",
      "content": "1180px",
      "reading": "760px"
    },
    "breakpoints": {
      "mobile": "480px",
      "tablet": "768px",
      "desktop": "1024px",
      "wide": "1440px"
    },
    "grid": {
      "gap": "24px",
      "columns": 12
    }
  },

  "borderRadius": {
    "none": "0",
    "sm": "5px",
    "md": "8px",
    "lg": "12px",
    "xl": "18px",
    "2xl": "24px",
    "pill": "9999px"
  },

  "borders": {
    "width": {
      "thin": "1px",
      "medium": "2px",
      "thick": "3px"
    },
    "color": {
      "subtle": "#EEE7DC",
      "default": "#E2D9CB",
      "strong": "#C8BBA7",
      "accent": "#C9A34A"
    }
  },

  "shadows": {
    "xs": "0 1px 2px rgba(31,41,51,0.04)",
    "sm": "0 2px 6px rgba(31,41,51,0.06)",
    "md": "0 5px 16px rgba(31,41,51,0.09)",
    "lg": "0 12px 32px rgba(31,41,51,0.12)"
  },

  "motion": {
    "duration": {
      "fast": "150ms",
      "normal": "220ms",
      "slow": "350ms"
    },
    "easing": {
      "standard": "ease",
      "emphasized": "cubic-bezier(0.2, 0.8, 0.2, 1)"
    },
    "reducedMotion": true
  },

  "zIndex": {
    "base": 1,
    "dropdown": 100,
    "sticky": 200,
    "overlay": 500,
    "modal": 600,
    "notification": 700,
    "tooltip": 800
  },

  "visualLanguage": {
    "direction": "Editorial Premium",
    "backgroundPreference": "Light surfaces",
    "goldLines": {
      "color": "#C9A34A",
      "width": "1px",
      "usage": [
        "section dividers",
        "editorial rules",
        "selected accents"
      ]
    },
    "goldDots": {
      "color": "#C9A34A",
      "size": "6px",
      "usage": [
        "line endpoints",
        "data markers",
        "controlled decorative details"
      ]
    },
    "composition": {
      "serifSansContrast": true,
      "generousWhitespace": true,
      "controlledRepetition": true,
      "avoidExcessiveDecoration": true
    },
    "restrictions": [
      "No generic leaf logo",
      "No generic water drop logo",
      "No generic globe logo",
      "No unnecessary hexagon patterns",
      "No dark backgrounds as default page surfaces",
      "No uncontrolled decorative gold elements"
    ]
  },

  "componentTokens": {
    "button": {
      "heightXs": "30px",
      "heightSm": "36px",
      "heightMd": "42px",
      "heightLg": "50px",
      "heightXl": "56px",
      "radius": "8px",
      "horizontalPadding": "20px"
    },
    "card": {
      "radius": "12px",
      "padding": "24px",
      "shadow": "xs",
      "border": "1px solid #E2D9CB"
    },
    "input": {
      "height": "44px",
      "radius": "8px",
      "borderColor": "#E2D9CB",
      "focusColor": "#173B63",
      "focusRing": "rgba(23,59,99,0.12)"
    },
    "badge": {
      "radius": "5px",
      "padding": "3px 10px",
      "fontSize": "0.75rem"
    },
    "table": {
      "headerBg": "#F7F3EC",
      "borderColor": "#EEE7DC",
      "rowHover": "#EAF2F8",
      "cellPadding": "13px 16px"
    },
    "alert": {
      "radius": "8px",
      "padding": "14px 16px"
    },
    "metric": {
      "radius": "12px",
      "padding": "20px",
      "valueSize": "2rem"
    }
  },

  "accessibility": {
    "standard": "WCAG 2.2 AA",
    "minimumContrast": {
      "normalText": "4.5:1",
      "largeText": "3:1",
      "uiComponents": "3:1"
    },
    "focusVisible": true,
    "keyboardNavigation": true,
    "reducedMotionSupport": true,
    "colorNotOnlyIndicator": true,
    "minimumTouchTarget": "24px",
    "recommendedTouchTarget": "44px"
  },

  "dataPresentation": {
    "numericFont": "IBM Plex Mono",
    "tabularNumbers": true,
    "numericDirection": "ltr",
    "preserveUnitMetadata": true,
    "preserveMeasurementPrecision": true,
    "showDataProvenance": true,
    "showValidationStatus": true,
    "showModelVersion": true
  }
