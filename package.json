{
  "name": "@eco-nojin/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Eco Nojin unified platform monorepo — one port, public core, specialised sections, real API.",
  "author": "Eco Nojin project (owner: mahak1988)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahak1988/HyDroMa.git"
  },
  "bugs": {
    "url": "https://github.com/mahak1988/HyDroMa/issues"
  },
  "homepage": "https://github.com/mahak1988/HyDroMa#readme",
  "packageManager": "pnpm@12.18.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/unified-dev.mjs",
    "dev:all": "node scripts/unified-dev.mjs",
    "dev:brand": "pnpm --filter @eco-nojin/brand run dev",
    "build": "node scripts/build-all.mjs",
    "build:all": "node scripts/build-all.mjs",
    "build:brand": "pnpm --filter @eco-nojin/brand run build",
    "preview": "node scripts/unified-serve.mjs",
    "start": "node scripts/unified-serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint archive/legacy-console/src archive/legacy-scientific-workspace/src archive/legacy-marketplace/src archive/legacy-tourism/src apps/brand/src apps/platform/src archive/legacy-field-collection/src packages/ui/src packages/icons/src packages/i18n/src packages/frontend-core/src packages/domain-types/src packages/spatial/src packages/validation/src packages/api-client/src packages/auth-client/src packages/configuration/src packages/utilities/src packages/scientific/src packages/app-shell/src packages/hydroma-client/src --ignore-pattern **/maplibre-gl-worker.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:arch": "node scripts/architecture-guardrails.mjs",
    "test:arch": "node --test scripts/architecture-guardrails.test.mjs scripts/check-tokens.test.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:e2e:list": "playwright test --list",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run check:boundaries && pnpm run check:arch && pnpm run test:arch && pnpm run check:tokens && pnpm run check:apps && pnpm run test && pnpm run test:api && pnpm run build:all && pnpm run check:bundle",
    "dev:platform": "pnpm --filter @eco-nojin/platform run dev",
    "build:platform": "pnpm --filter @eco-nojin/platform run build",
    "dev:api": "node services/api/src/server.mjs",
    "seed": "node services/api/scripts/seed.mjs",
    "test:api": "node --test services/api/tests/*.test.mjs",
    "check:apps": "node scripts/app-manifest.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "oxlint": "1.75.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
