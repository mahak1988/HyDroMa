{
  "packageManager": "pnpm@12.18.0",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "description": "Eco Nojin unified platform monorepo — one port, public core, specialised sections, real API.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/unified-dev.mjs",
    "dev:all": "node scripts/unified-dev.mjs",
    "dev:console": "pnpm --filter @eco-nojin/console run dev",
    "dev:science": "pnpm --filter @eco-nojin/scientific-workspace run dev",
    "dev:market": "pnpm --filter @eco-nojin/marketplace run dev",
    "dev:tourism": "pnpm --filter @eco-nojin/tourism run dev",
    "dev:brand": "pnpm --filter @eco-nojin/brand run dev",
    "build": "node scripts/build-all.mjs",
    "build:all": "node scripts/build-all.mjs",
    "build:console": "pnpm --filter @eco-nojin/console run build",
    "build:science": "pnpm --filter @eco-nojin/scientific-workspace run build",
    "build:market": "pnpm --filter @eco-nojin/marketplace run build",
    "build:tourism": "pnpm --filter @eco-nojin/tourism run build",
    "build:brand": "pnpm --filter @eco-nojin/brand run build",
    "preview": "node scripts/unified-serve.mjs",
    "start": "node scripts/unified-serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint apps/console/src apps/scientific-workspace/src apps/marketplace/src apps/tourism/src apps/brand/src apps/platform/src apps/field-collection/src packages/ui/src packages/icons/src packages/i18n/src packages/frontend-core/src packages/domain-types/src packages/spatial/src packages/validation/src packages/api-client/src packages/auth-client/src packages/configuration/src packages/utilities/src packages/scientific/src packages/app-shell/src packages/hydroma-client/src --ignore-pattern **/maplibre-gl-worker.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:science": "pnpm --filter @eco-nojin/scientific-workspace run test:e2e",
    "test:market": "pnpm --filter @eco-nojin/marketplace run test:e2e",
    "test:tourism": "pnpm --filter @eco-nojin/tourism run test:e2e",
    "test:e2e:list": "playwright test --list",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run check:boundaries && pnpm run check:tokens && pnpm run check:apps && pnpm run test && pnpm run test:api && pnpm run build:all && pnpm run check:bundle",
    "dev:platform": "pnpm --filter @eco-nojin/platform run dev",
    "build:platform": "pnpm --filter @eco-nojin/platform run build",
    "dev:api": "node services/api/src/server.mjs",
    "seed": "node services/api/scripts/seed.mjs",
    "test:api": "node --test services/api/tests/api.test.mjs",
    "dev:field": "pnpm --filter @eco-nojin/field-collection run dev",
    "build:field": "pnpm --filter @eco-nojin/field-collection run build",
    "check:apps": "node scripts/app-manifest.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "oxlint": "1.75.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
