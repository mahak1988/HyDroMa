{
  "name": "eco-nojin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eco Nojin frontend monorepo — one origin, seven surfaces, one shared foundation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/home",
    "apps/portal",
    "apps/console",
    "apps/marketplace",
    "apps/tourism",
    "apps/scientific-workspace",
    "apps/brand",
    "apps/platform",
    "packages/design-system",
    "packages/ui",
    "packages/icons",
    "packages/i18n",
    "packages/frontend-core",
    "packages/domain-types",
    "packages/spatial",
    "packages/validation",
    "packages/api-client",
    "packages/auth-client",
    "packages/configuration",
    "packages/utilities",
    "packages/scientific"
  ],
  "scripts": {
    "dev": "node scripts/unified-dev.mjs",
    "dev:all": "node scripts/unified-dev.mjs",
    "dev:home": "npm run dev --workspace @eco-nojin/home",
    "dev:console": "npm run dev --workspace @eco-nojin/console",
    "dev:portal": "npm run dev --workspace @eco-nojin/portal",
    "dev:science": "npm run dev --workspace @eco-nojin/scientific-workspace",
    "dev:market": "npm run dev --workspace @eco-nojin/marketplace",
    "dev:tourism": "npm run dev --workspace @eco-nojin/tourism",
    "dev:brand": "npm run dev --workspace @eco-nojin/brand",
    "build": "node scripts/build-all.mjs",
    "build:all": "node scripts/build-all.mjs",
    "build:home": "npm run build --workspace @eco-nojin/home",
    "build:console": "npm run build --workspace @eco-nojin/console",
    "build:portal": "npm run build --workspace @eco-nojin/portal",
    "build:portal:static": "npm run build:static --workspace @eco-nojin/portal",
    "build:science": "npm run build --workspace @eco-nojin/scientific-workspace",
    "build:market": "npm run build --workspace @eco-nojin/marketplace",
    "build:tourism": "npm run build --workspace @eco-nojin/tourism",
    "build:brand": "npm run build --workspace @eco-nojin/brand",
    "preview": "node scripts/unified-serve.mjs",
    "start": "node scripts/unified-serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint apps/console/src apps/portal/src apps/scientific-workspace/src apps/marketplace/src apps/tourism/src apps/home/src apps/brand/src apps/platform/src packages/ui/src packages/icons/src packages/i18n/src packages/frontend-core/src packages/domain-types/src packages/spatial/src packages/validation/src packages/api-client/src packages/auth-client/src packages/configuration/src packages/utilities/src packages/scientific/src --ignore-pattern **/maplibre-gl-worker.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:portal": "npm run test:e2e --workspace @eco-nojin/portal",
    "test:science": "npm run test:e2e --workspace @eco-nojin/scientific-workspace",
    "test:market": "npm run test:e2e --workspace @eco-nojin/marketplace",
    "test:tourism": "npm run test:e2e --workspace @eco-nojin/tourism",
    "test:e2e:list": "playwright test --list",
    "verify": "npm run typecheck && npm run lint && npm run check:boundaries && npm run check:tokens && npm run test && npm run build:all",
    "dev:platform": "npm run dev --workspace @eco-nojin/platform",
    "build:platform": "npm run build --workspace @eco-nojin/platform"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "oxlint": "1.75.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
